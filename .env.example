# 複製這個檔案為 .env，並填入你自己的值。
# .env 已加進 .gitignore，不會被 commit。

FOSSILMIND_API_KEY=your_api_key_here

# 以下為選填，預設值已經是原本課程用的 NCKU netdb gateway；換成自己的服務就改這裡
# FOSSILMIND_API_URL=https://api-gateway.netdb.csie.ncku.edu.tw/api/chat
# FOSSILMIND_MODEL_NAME=gpt-oss:20b

# 本機開發需要看到詳細錯誤時才設為 true；正式部署務必保持 false（或不設）
# FLASK_DEBUG=true
