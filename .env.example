# 複製這個檔案為 .env，並填入你自己的值。
# .env 已加進 .gitignore，不會被 commit。

# AI 服務的金鑰，選填。留空的話，第一次打開首頁會跳出設定視窗，讓你選服務並填入金鑰
FOSSILMIND_API_KEY=

# 共用金鑰對應的服務，預設是原本課程用的 NCKU netdb gateway；換成自己的服務就改這裡
# FOSSILMIND_API_URL=https://api-gateway.netdb.csie.ncku.edu.tw/api/chat
# FOSSILMIND_MODEL_NAME=gpt-oss:20b
# API 格式：ollama（NCKU gateway、本機 Ollama）或 openai（OpenAI 相容的 chat completions）
# FOSSILMIND_API_FORMAT=ollama

# 對話紀錄的 SQLite 檔案位置，預設是專案資料夾裡的 chats.db；Docker 部署時建議指到掛載的 volume
# FOSSILMIND_DB_FILE=/data/chats.db

# 開發用：設定視窗多一個「本機 Ollama」選項（Ollama 不檢查金鑰，隨便填都能用）。正式部署不要設
# Docker 裡要連主機上的 Ollama：http://host.docker.internal:11434/api/chat
# FOSSILMIND_LOCAL_OLLAMA_URL=http://localhost:11434/api/chat
# FOSSILMIND_LOCAL_OLLAMA_MODEL=qwen3:4b

# 本機開發需要看到詳細錯誤時才設為 true；正式部署務必保持 false（或不設）
# FLASK_DEBUG=true
